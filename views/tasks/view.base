filters: file.inFolder(this.file.folder)
properties:
  status:
    displayName: Status
  assignee:
    displayName: Assignee
  due:
    displayName: Due
  tags:
    displayName: Tags
views:
  - type: kanban
    name: Board
    filters: 'status != "Done"'
    order: [file.name, assignee, due, tags]
    groupBy:
      property: note.status
      direction: ASC
    groupOrder: [Todo, In progress, Done]
  - type: calendar
    name: Due dates
    filters: 'status != "Done"'
  - type: table
    name: Done
    filters: 'status == "Done"'
    order: [file.name, assignee, due, tags]
    sort:
      - property: due
        direction: DESC
