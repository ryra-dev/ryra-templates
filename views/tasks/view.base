filters: 'type == "task"'
properties:
  status:
    displayName: Status
  owner:
    displayName: Owner
  due:
    displayName: Due
views:
  - type: kanban
    name: Board
    order: [file.name, owner, due]
    groupBy:
      property: note.status
      direction: ASC
    groupOrder: [Todo, In progress, Done]
  - type: table
    name: All tasks
    order: [file.name, status, owner, due]
    sort:
      - property: due
        direction: ASC
  - type: calendar
    name: Due dates
