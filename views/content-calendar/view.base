filters: file.inFolder(this.file.folder)
properties:
  status:
    displayName: Status
  channel:
    displayName: Channel
  due:
    displayName: Publish
views:
  - type: calendar
    name: Calendar
    filters: 'status != "Published"'
  - type: kanban
    name: Status
    order: [file.name, channel, due]
    groupBy:
      property: note.status
      direction: ASC
    groupOrder: [Idea, Drafting, Review, Published]
