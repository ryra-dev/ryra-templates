filters: file.inFolder(this.file.folder)
formulas:
  when: 'if(due.date() < today(), "Overdue", "Today")'
  day: 'if(due.date() < today(), "Overdue", due.date())'
  project: 'if(file.folder == this.file.folder, "No project", if(this.file.folder, file.folder.slice(this.file.folder.length + 1), file.folder))'
properties:
  done:
    displayName: Done
  due:
    displayName: Due
  tags:
    displayName: Tags
  formula.day:
    displayName: Day
views:
  - type: list
    name: Today
    filters: 'done != true && due && due.date() <= today()'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.when
      direction: ASC
    groupOrder: [Overdue, Today]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Upcoming
    filters: 'done != true && due'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.day
      direction: ASC
    groupOrder: [Overdue]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Projects
    filters: 'done != true && (done == false || due)'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.project
      direction: ASC
    groupOrder: [Inbox]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Done
    filters: 'done == true'
    order: [done, file.name, tags]
    sort:
      - property: due
        direction: DESC
