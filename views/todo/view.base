filters: file.inFolder(this.file.folder)
formulas:
  when: 'if(!due, "No date", if(due.date() < today(), "Overdue", "Today"))'
  day: 'if(due.date() < today(), "Overdue", due.date())'
properties:
  done:
    displayName: Done
  due:
    displayName: Due
  tags:
    displayName: Tags
  formula.day:
    displayName: Day
views:
  - type: list
    name: Today
    filters: 'done != true && (!due || due.date() <= today())'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.when
      direction: ASC
    groupOrder: [Overdue, Today, No date]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Upcoming
    filters: 'done != true && due'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.day
      direction: ASC
    groupOrder: [Overdue]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Done
    filters: 'done == true'
    order: [done, file.name, tags]
    sort:
      - property: due
        direction: DESC
