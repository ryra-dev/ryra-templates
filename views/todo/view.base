filters: file.inFolder(this.file.folder)
formulas:
  state: 'if(done == true, "Done", "Open")'
  day: 'if(due.date() < today(), "Overdue", due.date())'
properties:
  done:
    displayName: Done
  due:
    displayName: Due
  tags:
    displayName: Tags
views:
  - type: list
    name: All todos
    filters: 'done == false || done == true || due'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.state
      direction: ASC
    groupOrder: [Open, Done]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Upcoming
    filters: 'done != true && due'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.day
      direction: ASC
    groupOrder: [Overdue]
    sort:
      - property: due
        direction: ASC
