filters: file.inFolder(this.file.folder)
formulas:
  day: 'if(due.date() < today(), "Overdue", due.date())'
properties:
  done:
    displayName: Done
  due:
    displayName: Due
  tags:
    displayName: Tags
views:
  - type: list
    name: Open
    filters: 'done == false || (done != true && due)'
    order: [done, file.name, due, tags]
    sort:
      - property: due
        direction: ASC
  - type: list
    name: Done
    filters: 'done == true'
    order: [done, file.name, due, tags]
  - type: list
    name: Upcoming
    filters: 'done != true && due'
    order: [done, file.name, due, tags]
    groupBy:
      property: formula.day
      direction: ASC
    groupOrder: [Overdue]
    sort:
      - property: due
        direction: ASC
