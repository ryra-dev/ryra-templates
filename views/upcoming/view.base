filters: file.inFolder(this.file.folder)
formulas:
  day: 'if(due.date() == today() + "1d", "Tomorrow", due.date())'
  project: 'if(this.file.folder, file.folder.slice(this.file.folder.length + 1), file.folder)'
properties:
  done:
    displayName: Done
  due:
    displayName: Due
  tags:
    displayName: Tags
  formula.day:
    displayName: Day
  formula.project:
    displayName: Project
views:
  - type: list
    name: Upcoming
    filters: 'done != true && due.date() > today()'
    order: [done, file.name, due, formula.project, tags]
    groupBy:
      property: formula.day
      direction: ASC
    groupOrder: [Tomorrow]
    sort:
      - property: due
        direction: ASC
